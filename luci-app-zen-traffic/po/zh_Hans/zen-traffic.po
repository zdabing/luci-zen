msgstr "接口"

msgid "Loading…"
msgstr "正在加载…"

msgid "WAN rates sampled every 5 seconds and retained for 7 days. Longer ranges show average rates."
msgstr "每5秒采集 WAN 上传、下载速率，保留最近7天。较长时间范围显示平均速率。"

msgid "Realtime history is unavailable. Update and enable the zen-traffic service."
msgstr "实时历史功能不可用，请更新并启用 zen-traffic 服务。"

msgid "Choose a valid time range within the last 7 days."
msgstr "请选择最近7天内有效的起止时间。"

msgid "Unable to query realtime history."
msgstr "查询实时历史失败，请检查服务状态后重试。"

msgid "Maximum displayed download"
msgstr "最高显示下载速率"

msgid "Maximum displayed upload"
msgstr "最高显示上传速率"

msgid "%d points · %d-second intervals"
msgstr "%d 个数据点 · 每%d秒一组"

msgid "No realtime history yet. Leave the service running to collect samples."
msgstr "所选范围暂无实时历史，请保持流量统计服务运行以采集数据。"
