{
	"luci-app-zen-traffic": {
		"description": "Grant ubus access for luci-app-zen-traffic",
		"read": {
			"ubus": {
				"zen.traffic": [
					"getStatus",
					"getDevices",
					"getTotal",
					"getHistory",
					"getRealtimeHistory",
					"getWanUsage",
					"getInternetHistory",
					"getNotifications",
					"getDeviceTimeline",
					"getAppUsage",
					"getDpiDiagnostics",
					"getDpiRules",
					"getAppRealtime"
				]
			}
		},
		"write": {
			"ubus": {
				"zen.traffic": [
					"setHostname",
					"resetDevice",
					"setNotifications",
					"testNotification",
					"setDpiDiagnostics",
					"setDpiRules",
					"rollbackDpiRules",
					"setDpiDns",
					"setDpiFeedback"
				]
			}
		}
	},
	"zen-device-management": {
		"description": "Rename devices, reserve DHCP addresses and manage per-device Internet policies",
		"read": {
			"ubus": {
				"zen.traffic": [
					"getDevicePolicy",
					"getP2pPolicy",
					"getP2pDomains"
				],
				"zen.device": [
					"getBinding"
				]
			}
		},
		"write": {
			"ubus": {
				"zen.traffic": [
					"setHostname",
					"setDevicePolicy",
					"setP2pPolicy",
					"setP2pDomains"
				],
				"zen.device": [
					"setBinding"
				]
			}
		}
	}
}
