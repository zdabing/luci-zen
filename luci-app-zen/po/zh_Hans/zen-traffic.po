msgstr "每月（保留日期汇总）"

msgid "Settings saved; newer changes still need to be saved."
msgstr "设置已保存；保存期间的新修改还需再次保存。"

msgid "Enter the official Feishu bot webhook URL."
msgstr "请填写飞书机器人的官方 Webhook 地址。"

msgid "Enter the official WeCom bot webhook URL."
msgstr "请填写企业微信机器人的官方 Webhook 地址。"

msgid "Enable a notification channel first."
msgstr "请先启用一个通知渠道。"

msgid "Check the bot signing secret."
