msgid "Set the router’s time before sending messages."
msgstr "发送消息前，请先校准路由器时间。"

msgid "Wait one minute before testing again."
msgstr "请等一分钟后再发送测试消息。"

msgid "Save the webhook first."
msgstr "请先保存机器人 Webhook 地址。"

msgid "The HTTPS sender is unavailable. Check that curl is installed."
msgstr "HTTPS 发送程序不可用，请检查是否安装了 curl。"

msgid "The robot did not return a valid acknowledgement."
msgstr "机器人没有返回有效的成功确认。"

