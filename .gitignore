# Local documentation, prototypes, previews and verification tools
/doc/
/docs/
/dev-preview/
/poc/
/tools/
/reference/
/.zcode/
/.zcodeignore
/.codex/
/.vscode/
/.idea/
/.github/workflows/r5c-acceptance.yml

# Standalone tests and fixtures stay local; production source stays tracked
**/test/
**/tests/
**/__tests__/
**/fixtures/
test-*
*_test.*
*.test.*
*.spec.*
/test-results/
/playwright-report/
/coverage/

# Publish only the project overview, release notes and required license notices
*.md
!/README.md
!/CHANGELOG.md
!/luci-app-zen/THIRD_PARTY_NOTICES.md
*.doc
*.docx
*.pdf

# Build outputs, local runtimes and generated packages
target/
build/
dist/
node_modules/
