#!/bin/sh /etc/rc.common
# zen-traffic init — procd 管理下的 zen-trafficd
#
# 职责（ARCHITECTURE §4）：
#   - bpffs 自动挂载（BPF 加载前置条件）；
#   - UCI /etc/config/zen-traffic → daemon 命令行；
#   - 配置 reload 重启以应用挂载设备；网络事件仅更新前缀/上游，不重启。

USE_PROCD=1
START=95
STOP=10

NAME=zen-traffic
PROG=/usr/bin/zen-trafficd
BPF_OBJ=/usr/share/zen-traffic/zen_traffic.bpf.o

# config_list_foreach 回调共享同一 shell，直接追加到全局暂存
IFACES=""
PREFIXES=""

append_iface() {
	IFACES="$IFACES $1"
}

append_prefix() {
	PREFIXES="$PREFIXES $1"
}

ensure_bpffs() {
	grep -q "bpf /sys/fs/bpf" /proc/mounts 2>/dev/null || \
		mount -t bpf bpf /sys/fs/bpf 2>/dev/null
}

start_service() {
	config_load "$NAME"

	local enabled
	config_get_bool enabled traffic enabled 1
	[ "$enabled" = "1" ] || return 0

	# Check runtime prerequisites before procd enters its respawn loop.
	if ! /usr/libexec/zen-traffic-check; then
		logger -t zen-traffic 'Runtime prerequisites missing; run /usr/libexec/zen-traffic-check'
		return 1
	fi

	IFACES=""
	PREFIXES=""
	config_list_foreach traffic interface append_iface
	config_list_foreach traffic extra_prefix append_prefix

	local interval offline checkpoint db_path
	config_get interval traffic interval "1000"
	config_get offline traffic offline_timeout "600"
	config_get checkpoint traffic checkpoint_secs "300"
	config_get db_path traffic db_path "/etc/zen-traffic/traffic.db"

	ensure_bpffs || {
		logger -t zen-traffic 'Cannot mount /sys/fs/bpf; check kernel BPF support'
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" \
		-b "$BPF_OBJ" \
		-c "$checkpoint" \
		-o "$offline" \
		-d "$db_path"
	[ -n "$IFACES" ] && for i in $IFACES; do
		procd_append_param command -i "$i"
	done
	procd_append_param command -t "$interval"
	[ -n "$PREFIXES" ] && for p in $PREFIXES; do
		procd_append_param command -P "$p"
	done
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
	# 接口子网变化都可能改变本地流量分类；合并事件后仅刷新，不重启 daemon。
	procd_add_raw_trigger "interface.*" 3000 /usr/bin/ubus call zen.traffic reloadPrefixes
}
