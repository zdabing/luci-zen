#!/bin/sh /etc/rc.common
# zen-capture init — 独立抓包守护进程（docs/PACKET_CAPTURE.md）
#
# 职责：
#   - UCI /etc/config/zen-traffic capture 段 → zen-capture 命令行；
#   - procd respawn 隔离：抓包崩溃不影响 zen-trafficd；
#   - 输出目录存在性由 daemon 自建；/tmp 重启清空为预期行为。

USE_PROCD=1
START=96
STOP=10

NAME=zen-traffic
PROG=/usr/bin/zen-capture

IFACES=""
SKIPS=""

append_iface() {
	IFACES="$IFACES $1"
}

append_skip() {
	SKIPS="$SKIPS $1"
}

start_service() {
	config_load "$NAME"

	local enabled
	config_get_bool enabled capture enabled 1
	[ "$enabled" = "1" ] || return 0

	IFACES=""
	SKIPS=""
	config_list_foreach capture interface append_iface
	config_list_foreach capture decrypt_skip append_skip

	local dir sessions duration file_mb snaplen keep bpf ca_dir
	config_get dir capture dir "/tmp/zen-capture"
	config_get sessions capture max_sessions "2"
	config_get duration capture max_duration "600"
	config_get file_mb capture max_file_mb "8"
	config_get snaplen capture snaplen "256"
	config_get keep capture keep "10"
	config_get bpf capture bpf "/usr/share/zen-traffic/zen_capture.bpf.o"
	config_get ca_dir capture ca_dir "/etc/zen-capture"

	procd_open_instance
	procd_set_param command "$PROG" \
		-d "$dir" \
		-s "$sessions" \
		-T "$duration" \
		-M "$file_mb" \
		-S "$snaplen" \
		-K "$keep" \
		-B "$bpf" \
		-C "$ca_dir"
	[ -n "$IFACES" ] && for i in $IFACES; do
		procd_append_param command -i "$i"
	done
	[ -n "$SKIPS" ] && for n in $SKIPS; do
		procd_append_param command -N "$n"
	done
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}
