 luci-theme-zen — LuCI ucode theme.
-#}

{%
	import { getuid, getspnam } from 'luci.core';
	import { stat } from 'fs';
	import { cursor } from 'uci';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const appearance = cursor().get_all('zen', 'appearance') ?? {};

	// version tag for theme static assets: changes whenever any package
	// operation touches the package manager database (incl. theme upgrades),
	// so browser caches are invalidated automatically. Check both
	// apk and opkg databases since either may be absent depending on the
	// system; use the newest mtime found.
	const apk_mtime = stat('/lib/apk/db/installed')?.mtime ?? 0;
	const opkg_mtime = stat('/usr/lib/opkg/status')?.mtime ?? 0;
	const pkgmtime = apk_mtime > opkg_mtime ? apk_mtime : opkg_mtime;

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-zen-appearance="router" data-zen-authenticated="{{ ctx.authsession ? 'true' : 'false' }}" data-zen-saved="{{ appearance.saved == '1' ? 'true' : 'false' }}" data-zen-mode="{{ entityencode(appearance.mode ?? 'auto', true) }}" data-zen-accent="{{ entityencode(appearance.accent ?? 'macaron', true) }}" data-zen-material="{{ entityencode(appearance.material ?? 'glass', true) }}" data-zen-layout="{{ entityencode(appearance.layout ?? 'sidebar', true) }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<script src="{{ media }}/appearance.js?v={{ pkgmtime }}"></script>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="darkreader-lock">
		<link rel="stylesheet" href="{{ media }}/cascade.css?v={{ pkgmtime }}">
		<link rel="stylesheet" href="{{ media }}/mobile.css?v={{ pkgmtime }}">
		<link rel="stylesheet" href="{{ media }}/appearance.css?v={{ pkgmtime }}">
		<link rel="stylesheet" href="{{ media }}/appearance-zen.css?v={{ pkgmtime }}">
		<link rel="stylesheet" href="{{ media }}/custom.css?v={{ pkgmtime }}">
		<link rel="icon" href="{{ media }}/logo.svg?v={{ pkgmtime }}" sizes="any" type="image/svg+xml">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ pkgmtime }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ ctx.authsession ? 'logged-in' : '' }} {{ length(ctx.path) ? `node-${join('-', ctx.path)}` : 'node-main-login' }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
		{% if (!blank_page): %}
		<header>
			<div class="fill">
				<div class="container">
					<button type="button" class="showSide" title="{{ _('Toggle menu') }}" aria-label="{{ _('Toggle menu') }}" aria-controls="mainmenu" aria-expanded="true"></button>
					<a id="logo" href="{{ ctx.authsession ? dispatcher.build_url(dispatcher.lookup('admin/zen') ? 'admin/zen' : 'admin/status/overview') : '#' }}">
						<img src="{{ media }}/logo.svg?v={{ pkgmtime }}" alt="Zen">
					</a>
					<a class="brand" href="{{ ctx.authsession ? dispatcher.build_url(dispatcher.lookup('admin/zen') ? 'admin/zen' : 'admin/status/overview') : '#' }}">{{ striptags(`${boardinfo.hostname ?? '?'}`) }}</a>
					<span class="status" id="indicators"></span>
					<div class="zen-header-actions">
						<button type="button" id="theme-toggle" class="theme-toggle zen-mode-toggle" title="{{ _('Toggle light/dark mode') }}" aria-label="{{ _('Toggle light/dark mode') }}">
							<svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
							<svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
							<span id="theme-toggle-label" class="zen-mode-label">{{ _('Dark mode') }}</span>
						</button>
						{% if (ctx.authsession && dispatcher.lookup('admin/status/zen-traffic/settings')): %}
						<a class="zen-appearance-trigger zen-settings-link" href="{{ dispatcher.build_url('admin/status/zen-traffic/settings') }}" aria-label="{{ _('Zen settings') }}" title="{{ _('Zen settings') }}">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="8" cy="8" r="1"/><circle cx="14" cy="6" r="1"/><circle cx="17" cy="11" r="1"/><path d="M12 21c-2-3 0-4 2-5s1-3-1-3H9"/></svg>
							<span class="zen-appearance-label">{{ _('Zen settings') }}</span>
						</a>
						{% else %}
						<button type="button" class="zen-appearance-trigger" aria-label="{{ _('Theme settings') }}" title="{{ _('Theme settings') }}" aria-haspopup="dialog" aria-controls="zen-appearance-dialog">
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="8" cy="8" r="1"/><circle cx="14" cy="6" r="1"/><circle cx="17" cy="11" r="1"/><path d="M12 21c-2-3 0-4 2-5s1-3-1-3H9"/></svg>
							<span class="zen-appearance-label">{{ _('Theme settings') }}</span>
						</button>
						{% endif %}
					</div>
				</div>
			</div>
		</header>
		<div class="main">
			<div class="loading"><span><div class="loading-img"></div>{{ _('Collecting data...') }}</span></div>
			<div class="main-left" id="mainmenu" style="display:none">
				<div class="sidebar-footer">
					{% if (ctx.authsession && dispatcher.lookup("admin/logout")): %}
					<a class="logout" href="{{ dispatcher.build_url('admin/logout') }}" data-title="{{ _('Logout') }}">{{ _('Logout') }}</a>
					{% endif %}
				</div>
			</div>
			<div class="main-right">
				<div class="modemenu-buttons" style="display:none">
					<ul id="modemenu"></ul>
				</div>
				<div class="darkMask"></div>
				<div id="maincontent">
					<div class="container">
						{% if (getuid() == 0 && getspnam('root')?.pwdp === '' && ctx.authsession): %}
							<div class="alert-message warning">
								<h4>{{ _('No password set!') }}</h4>
								<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
								{% if (dispatcher.lookup("admin/system/admin")): %}
								  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
								{% endif %}
							</div>
						{% endif %}

						{% if (boardinfo.rootfs_type == "initramfs"): %}
							<div class="alert-message warning">
								<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
								<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
								{% if (dispatcher.lookup("admin/system/flash")): %}
								  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
								{% endif %}
							</div>
						{% endif %}

						<noscript>
							<div class="alert-message warning">
								<h4>{{ _('JavaScript required!') }}</h4>
								<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
							</div>
						</noscript>

						<div id="tabmenu" style="display:none"></div>
		{% endif %}
