{
	"luci-theme-zen": {
		"description": "Grant dashboard stats for luci-theme-zen",
		"read": {
			"cgi-io": [ "exec", "download" ],
			"ubus": {
				"file": [ "read" ],
				"system": [ "info", "board" ],
				"luci": [ "getMountPoints", "getVersion" ],
				"luci-rpc": [ "getDHCPLeases", "getNetworkDevices", "getHostHints" ],
				"network.device": [ "status" ],
				"zen.traffic": [ "getStatus", "getDevices", "getTotal", "getHistory", "getRealtimeHistory", "getWanUsage" ]
			},
			"file": {
				"/proc/stat": [ "read" ],
				"/usr/libexec/package-manager-call list-installed": [ "exec" ],
				"/lib/apk/db/installed": [ "read" ],
				"/usr/lib/opkg/status": [ "read" ],
				"/usr/share/10wrt/release.json": [ "read" ]
			}
		}
	}
}
