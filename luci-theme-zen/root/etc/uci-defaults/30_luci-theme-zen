#!/bin/sh

changed_luci=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" 2>/dev/null; then
		uci set "luci.$key=$val"
		changed_luci=1
	fi
}

set_opt themes.Zen /luci-static/zen

if [ "$PKG_UPGRADE" != 1 ] && [ $changed_luci = 1 ]; then
	set_opt main.mediaurlbase /luci-static/zen
fi

if [ $changed_luci = 1 ]; then
	uci commit luci
fi

# Remove only the cache prefixes registered by older Zen packages.
# New installs use the firmware's regular static file serving.
H=/usr/share/ucode/luci-zen/zen-cache.uc
changed_uhttpd=0
for P in /luci-static/zen /luci-static/resources/menu-zen.js /luci-static/resources/view/zen; do
	case " $(uci -q get uhttpd.main.ucode_prefix) " in
		*" $P=$H "*)
			uci -q del_list uhttpd.main.ucode_prefix="$P=$H" && changed_uhttpd=1
			;;
	esac
done
if [ "$changed_uhttpd" = 1 ]; then
	uci commit uhttpd
	/etc/init.d/uhttpd reload >/dev/null 2>&1 || true
fi

exit 0
